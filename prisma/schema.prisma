}

model InputOrder {
  id                String            @id @default(uuid())
  order_number      String            @unique
  requestId         String
  farmerId          String
  supplierId        String
  status            InputOrderStatus @default(PENDING)
  ordered_date      DateTime          @default(now())
  expected_delivery DateTime?
  delivered_at      DateTime?
