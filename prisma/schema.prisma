  currency          String            @default("NGN")
  delivery_address  String?           @db.Text
  delivery_lat      Float?
  delivery_lng      Float?
  tracking_number   String?
  delivered_by_id   String?
  notes             String?           @db.Text
  paidFromWalletId  String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  request           InputRequest      @relation(fields: [requestId], references: [id], map: "fk_input_order_request")
