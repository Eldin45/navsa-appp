model InputRequest {
  id                 String             @id @default(uuid())
  request_number     String             @unique
  farmerId           String
  farmId             String?
  cycleId            String?
  status             InputRequestStatus @default(PENDING)
  requested_date     DateTime           @default(now())
  needed_by_date     DateTime?
  total_amount       Float
  currency           String             @default("NGN")
  notes              String?            @db.Text
  approved_by_id     String?
  approved_at        DateTime?
  rejection_reason   String?
  funded_by_id       String?
  funded_at          DateTime?
  funded_amount      Float?
  fundedFromWalletId String?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  farmer             User               @relation("InputRequestFarmer", fields: [farmerId], references: [id], map: "fk_input_request_farmer")
  approvedBy         User?              @relation("InputRequestApprover", fields: [approved_by_id], references: [id], map: "fk_input_request_approver")
  fundedBy           User?              @relation("InputRequestFunder", fields: [funded_by_id], references: [id], map: "fk_input_request_funder")
