  current_crop      String?
  crop_variety      String?
  planting_date     DateTime?
  expected_harvest  DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_farm_user")
  group             FarmGroup?  @relation(fields: [groupId], references: [id], map: "fk_farm_group")
  fields            FarmField[]
  devices           IoTDevice[]
  weatherStations   WeatherStation[]

  @@index([userId])
  @@index([groupId])
  @@map("farms")
}

model FarmField {
  id                String      @id @default(uuid())
  farmId            String
  name              String?
  field_number      String
  latitude          Float?
  longitude         Float?
  gps_boundary      String?     @db.LongText
  area_ha           Float
  soil_type         String?
  soil_depth        Float?
  status            String      @default("ACTIVE")
  irrigation_method String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  farm              Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade, map: "fk_farm_field_farm")
  cropCycles        CropCycle[]
  devices           IoTDevice[]

  @@index([farmId])
  @@map("farm_fields")
}

model CropCycle {
  id               String      @id @default(uuid())
  fieldId          String
  cycle_number     Int
  cycle_name       String?
  crop_type        String
  variety          String?
  planting_date    DateTime
  expected_harvest DateTime?
  actual_harvest   DateTime?
  status           CycleStatus @default(PLANTED)
  seeds_used_kg    Float?
  fertilizer_used  String?     @db.LongText
  pesticides_used  String?     @db.LongText
  total_yield_kg   Float?      @default(0)
  yield_per_ha     Float?
  total_cost       Float?      @default(0)
  revenue          Float?      @default(0)
  profit           Float?      @default(0)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  field            FarmField   @relation(fields: [fieldId], references: [id], onDelete: Cascade, map: "fk_crop_cycle_field")
  activities       CropActivity[]
  harvests         Harvest[]
  aiAdvice         AIAgronomyAdvice[]

  @@index([fieldId, cycle_number])
  @@index([status])
  @@map("crop_cycles")
}

model CropActivity {
  id               String           @id @default(uuid())
  cycleId          String
  activity_type    CropActivityType
  activity_date    DateTime
  performed_by     String?
  details          String?          @db.LongText
  water_volume     Float?
  duration_hours   Float?
  product_name     String?
  product_quantity Float?
  product_unit     String?
  observations     String?
  photos           String?          @db.LongText
  total_cost       Float?           @default(0)
  created_at       DateTime         @default(now())

  cycle            CropCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade, map: "fk_crop_activity_cycle")

  @@index([cycleId, activity_date])
  @@map("crop_activities")
}

model Harvest {
  id            String    @id @default(uuid())
  cycleId       String
  fieldId       String
  farmId        String
  harvest_date  DateTime
  quantity      Float
  unit          String    @default("KG")
  quality_grade String?
  moisture_pct  Float?
  status        String    @default("RECORDED")
  harvested_by  String?
  verified_by   String?
  verified_at   DateTime?
  notes         String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  cycle         CropCycle @relation(fields: [cycleId], references: [id], map: "fk_harvest_cycle")

  @@index([cycleId])
  @@index([farmId, harvest_date])
  @@map("harvests")
}

// ============================================================
// IOT & WEATHER
// ============================================================

model IoTDevice {
  id                String          @id @default(uuid())
  farmId            String
  fieldId           String?
  userId            String?
  device_type       IoTDeviceType
  device_model      String?
  manufacturer      String?
  serial_number     String?         @unique
  installed_date    DateTime
  location_lat      Float?
  location_lng      Float?
  connection_type   String?
  sim_card_number   String?
  signal_strength   Int?
  power_source      String?
  battery_level     Int?
  status            IoTDeviceStatus @default(ACTIVE)
  reading_frequency Int?
  last_reading      DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  farm              Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade, map: "fk_iot_device_farm")
  field             FarmField?      @relation(fields: [fieldId], references: [id], map: "fk_iot_device_field")
  user              User?           @relation(fields: [userId], references: [id], map: "fk_iot_device_user")

  readings          IoTReading[]    @relation("DeviceReadings")
  alerts            IoTAlert[]      @relation("DeviceAlerts")

  actuator          IoTDeviceActuator?
  actuatorCommands  IoTActuatorCommand[]

  @@index([farmId])
  @@index([device_type, status])
  @@map("iot_devices")
}

model IoTReading {
  id              String    @id @default(uuid())
  deviceId        String
  reading_time    DateTime  @default(now())
  reading_type    String
  reading_value   Float
  unit            String
  sensor_index    Int?
  sensor_depth    Float?
  reading_quality String?
  is_calibrated   Boolean   @default(true)
  raw_data        String?   @db.LongText
  created_at      DateTime  @default(now())

  device          IoTDevice @relation("DeviceReadings", fields: [deviceId], references: [id], onDelete: Cascade, map: "fk_iot_reading_device")

  @@index([deviceId, reading_time])
  @@index([reading_type])
  @@map("iot_readings")
}

model IoTAlert {
  id                String    @id @default(uuid())
  deviceId          String
  alert_type        String
  severity          String
  threshold_min     Float?
  threshold_max     Float?
  actual_value      Float
  detected_at       DateTime  @default(now())
  resolved_at       DateTime?
  status            String    @default("ACTIVE")
  notification_sent Boolean   @default(false)
  farm_id           String?
  field_id          String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  device            IoTDevice @relation("DeviceAlerts", fields: [deviceId], references: [id], onDelete: Cascade, map: "fk_iot_alert_device")

  @@index([deviceId, status])
  @@map("iot_alerts")
}

// ============================================================
// ACTUATOR CONFIG (1:1 with IoTDevice when device is an actuator)
// ============================================================

model IoTDeviceActuator {
  id              String        @id @default(uuid())
  deviceId        String        @unique

  // Control mode + current state
  mode            ActuatorMode  @default(MANUAL)
  state           ActuatorState @default(OFF)
  lastStateChange DateTime?
  lastChangedBy   String?

  // AUTO rule — pair of thresholds on a chosen reading type
  triggerType     String?       // e.g. "SOIL_MOISTURE", "TEMPERATURE", "HUMIDITY", "RAINFALL"
  triggerUnit     String?       // e.g. "%", "°C"
  onBelow         Float?        // turn ON when reading < onBelow
  offAbove        Float?        // turn OFF when reading > offAbove

  // Safety
  maxRunMinutes   Int?          // auto-off after this many minutes regardless
  cooldownMinutes Int?          // min gap between ON cycles

  // Runtime accounting
  totalRuntimeMinutes Int       @default(0)
  lastRunStartedAt    DateTime?

  // Metadata
  metadata        Json?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  device          IoTDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade, map: "fk_actuator_device")

  @@index([mode])
  @@index([state])
  @@map("iot_device_actuators")
}

// ============================================================
// ACTUATOR COMMAND LOG
// ============================================================

model IoTActuatorCommand {
  id           String                @id @default(uuid())
  deviceId     String
  action       ActuatorState
  source       ActuatorCommandSource @default(MANUAL)
  triggeredBy  String?
  reason       String?               @db.Text
  readingValue Float?
  readingType  String?
  success      Boolean               @default(true)
  errorMessage String?               @db.Text
  created_at   DateTime              @default(now())

  device       IoTDevice             @relation(fields: [deviceId], references: [id], onDelete: Cascade, map: "fk_actuator_cmd_device")
  triggeredByUser User?              @relation(fields: [triggeredBy], references: [id], map: "fk_actuator_cmd_user")

  @@index([deviceId, created_at])
  @@index([source])
  @@map("iot_actuator_commands")
}

model WeatherStation {
